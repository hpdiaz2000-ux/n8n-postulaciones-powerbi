    {
      "parameters": {
        "jsCode": "const slug = s => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);\n\nreturn $input.all().flatMap(item => {\n  const f = item.json;\n  const campo = n => (f[n] || '').toString().trim();\n\n  // Sin link no se escribe nada (protección)\n  let link = campo('Link del aviso'), m;\n  if (!link) return [];\n\n  // Link normalizado igual que en el flujo de Gmail, para que calcen\n  if ((m = link.match(/jobs\\/view\\/(\\d+)/) || link.match(/currentJobId=(\\d+)/))) {\n    link = 'https://www.linkedin.com/jobs/view/' + m[1] + '/';\n  } else if ((m = link.match(/[?&]v?jk=([0-9a-f]{16})/i))) {\n    link = 'https://cl.indeed.com/viewjob?jk=' + m[1];\n  }\n\n  const empresa = campo('Empresa'), cargo = campo('Cargo');\n  const fechaForm = campo('Fecha de postulación').slice(0, 10);\n\n  // Solo se envían los campos con datos, para no borrar lo que ya está en la fila\n  const fila = { Link: link, Estado: 'Postulado' };\n  if (fechaForm) fila.Fecha = fechaForm;\n  if (campo('Descripción del cargo')) fila['Descripción del cargo'] = campo('Descripción del cargo');\n  if (empresa) fila.Empresa = empresa;\n  if (cargo) fila.Cargo = cargo;\n  if (empresa && cargo && fechaForm) fila.ID = slug(empresa) + '-' + slug(cargo) + '-' + fechaForm.replace(/-/g, '');\n  if (campo('Renta pedida')) fila.Renta = campo('Renta pedida');\n  if (campo('Plataforma')) fila.Plataforma = campo('Plataforma');\n  if (campo('Notas')) fila.Notas = campo('Notas');\n\n  return [{ json: fila }];\n});"
      },
