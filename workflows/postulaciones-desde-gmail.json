    {
      "parameters": {
        "jsCode": "const slug = s => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);\n\nfunction familia(c) {\n  c = (c || '').toLowerCase();\n  if (/business partner|estrategia ti|transformaci/.test(c)) return 'Business Partner TI / Datos';\n  if (/datos|data|\\bbi\\b|business intelligence|analytics|power bi|anal[ií]tica/.test(c)) return 'BI y Datos';\n  if (/proyecto|project|pmo/.test(c)) return 'Proyectos TI';\n  if (/soporte|mesa|service desk|servicios|operaciones|infraestructura|site lead|incidentes|encargad|jefe ti/.test(c)) return 'Gestión de servicios TI';\n  return '';\n}\n\nfunction rubro(e) {\n  e = (e || '').toLowerCase();\n  if (/miner|mining|codelco|collahuasi|bhp|anglo|antofagasta|sqm|escondida|teck|kinross/.test(e)) return 'Minería';\n  if (/pharma|farma|laboratorio|gr[uü]nenthal|abbott|roche|novartis|bayer|medical|m[eé]dic/.test(e)) return 'Insumos médicos / Farma';\n  return 'Otro';\n}\n\nfunction htmlATexto(html) {\n  return (html || '')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/(p|div|tr|td|li|h\\d)>/gi, '\\n')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<').replace(/&gt;/g, '>');\n}\n\nreturn $input.all().map(item => {\n  const j = item.json;\n  const headers = (j.payload && j.payload.headers) || [];\n  const h = n => (headers.find(x => x.name.toLowerCase() === n) || {}).value || '';\n  const asunto = j.subject || j.Subject || h('subject') || '';\n  const cuerpo = j.text || htmlATexto(j.html) || j.snippet || '';\n  const todo = asunto + '. ' + cuerpo + ' ' + (j.html || '');\n  const cuando = j.date ? new Date(j.date) : new Date(Number(j.internalDate) || Date.now());\n  const fecha = cuando.toLocaleDateString('sv-SE', { timeZone: 'America/Santiago' });\n  const lineas = cuerpo.split('\\n')\n    .map(s => s.replace(/[\\u034f\\u200b-\\u200d\\ufeff\\u00a0]/g, ' ').trim())\n    .filter(Boolean);\n  // sin líneas de imágenes ni de links\n  const limpias = lineas.filter(l => !/^\\[image:.*\\]$/i.test(l) && !/^<?https?:\\/\\//i.test(l));\n\n  let plataforma = 'Otro', empresa = '', cargo = '', ubicacion = '', link = '', estado = 'Postulado', m;\n\n  if ((m = asunto.match(/Tu solicitud para el puesto de (.+) en (.+)$/i))) {\n    // Rechazo de LinkedIn\n    plataforma = 'LinkedIn'; cargo = m[1].trim(); empresa = m[2].trim(); estado = 'Rechazado';\n\n  } else if ((m = (asunto + '. ' + cuerpo).match(/se ha enviado tu solicitud a ([^.\\n]+)/i))) {\n    // Confirmación de LinkedIn: Cargo / Empresa / Ubicación  o  Cargo / Empresa · Ubicación\n    plataforma = 'LinkedIn'; empresa = m[1].trim();\n    const emp = empresa.toLowerCase();\n    const k = limpias.findIndex(l => {\n      const x = l.toLowerCase();\n      return x === emp || x.startsWith(emp + ' ·');\n    });\n    if (k > 0) {\n      const anterior = limpias[k - 1];\n      if (!/se ha enviado tu solicitud/i.test(anterior)) cargo = anterior;\n      if (limpias[k].includes('·')) {\n        ubicacion = limpias[k].split('·').slice(1).join('·').trim();\n      } else {\n        const siguiente = limpias[k + 1] || '';\n        if (siguiente && !/^Ver anuncio/i.test(siguiente)) ubicacion = siguiente;\n      }\n    }\n    const id = todo.match(/jobs\\/view\\/(\\d+)/);\n    if (id) link = 'https://www.linkedin.com/jobs/view/' + id[1] + '/';\n\n  } else if ((m = asunto.match(/Postulación en Indeed:\\s*(.+)/i))) {\n    // Confirmación de Indeed\n    plataforma = 'Indeed'; cargo = m[1].trim();\n    const jk = todo.match(/jk=([0-9a-f]{16})/i);\n    if (jk) link = 'https://cl.indeed.com/viewjob?jk=' + jk[1];\n\n  } else if (/recibieron tu postulación/i.test(asunto + ' ' + cuerpo)) {\n    // Confirmación de Laborum\n    plataforma = 'Laborum';\n    const i = limpias.findIndex(l => /^\\W*Te postulaste a/i.test(l));\n    if (i >= 0 && limpias[i + 1]) cargo = limpias[i + 1];\n  }\n\n  const salida = {\n    ID: slug(empresa || plataforma) + '-' + slug(cargo) + '-' + fecha.replace(/-/g, ''),\n    Fecha: fecha,\n    Empresa: empresa,\n    Cargo: cargo,\n    Familia: familia(cargo),\n    Rubro: rubro(empresa),\n    'Ubicación': ubicacion,\n    Estado: estado,\n    Plataforma: plataforma,\n    Link: link\n  };\n  // La nota automática solo va en filas sin link, para no pisar tus notas del formulario\n  if (!link) salida.Notas = 'Auto n8n: ' + asunto;\n  return { json: salida };\n});"
      },
